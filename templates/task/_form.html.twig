{{ form_start(form) }}

    <div class="p-4 form container-background">
        <div class="container">
            <div class="row justify-content-md-center">
                <div class='col-5 mb-3'>
                    <h5>Titre</h5>            
                    {{ form_errors(form.title) }}
                    {{ form_widget(form.title) }}
                </div>
                <div class='col-3'>
                    <h5>Prix</h5>            
                    {{ form_errors(form.price) }}
                    <div class="input-group">
                    {{ form_widget(form.price) }}
                        <div class="input-group-append">
                            <span class="input-group-text">€</span>
                        </div>
                    </div>
                </div>
                <div class='col-4'>
                    <h5>Couleur</h5>            
                    {{ form_errors(form.color) }}
                    {{ form_widget(form.color, {'attr': {'class': 'form-control form-control-color', 'title': 'Choisir une couleur'}}) }}
                </div>

                <button class="green-btn py-2 px-4 mt-3">{{ button_label|default('Valider') }}</button>
            </div>
        </div>
    </div>

{{ form_end(form) }}
